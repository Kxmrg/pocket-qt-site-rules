{
  "schemaVersion": 1,
  "type": "site",
  "id": "hdsky",
  "code": 2,
  "publishedAt": 1792028576,
  "architecture": "nexusphp",
  "domains": [
    "hdsky.me"
  ],
  "compatibility": {
    "engine": 1,
    "features": [
      "tag-filter.v1"
    ]
  },
  "base": {
    "minCode": 16,
    "maxCode": 17
  },
  "patches": [
    {
      "op": "replace",
      "path": "/pages/list/request/query/resource-tag",
      "value": {
        "id": "resource-tag",
        "input": "tag",
        "param": "tag_id",
        "map": {}
      }
    },
    {
      "op": "prepend",
      "path": "/pages/list/parsers/semantic/fields/downloadUrl/candidates",
      "value": [
        {
          "id": "signed-download",
          "read": {
            "css": "form[action*=\"download.php?id=\"]:not([action*=\"type=zip\"])",
            "mode": "attribute",
            "attribute": "action"
          },
          "then": [
            "url"
          ]
        }
      ]
    }
  ]
}
