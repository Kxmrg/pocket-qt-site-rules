{
  "schemaVersion": 1,
  "type": "site",
  "id": "cspt",
  "code": 6,
  "publishedAt": 1792028576,
  "architecture": "nexusphp",
  "domains": [
    "cspt.top"
  ],
  "compatibility": {
    "engine": 1,
    "features": [
      "tag-filter.v1"
    ]
  },
  "base": {
    "minCode": 11,
    "maxCode": 17
  },
  "patches": [
    {
      "op": "replace",
      "path": "/pages/list/request/query/resource-tag",
      "value": {
        "id": "resource-tag",
        "input": "tag",
        "param": "include_any_tags",
        "map": {
          "no-repost": 1,
          "premiere": 2,
          "official-release": 3,
          "diy": 4,
          "mandarin": 5,
          "chinese-subtitles": 6,
          "hdr": 7,
          "dolby": 11,
          "cantonese": 12,
          "completed": 9,
          "episodic": 21,
          "resident": 23
        }
      }
    },
    {
      "op": "prepend",
      "path": "/pages/account/parsers",
      "value": [
        {
          "id": "cspt-panel",
          "scope": "#user-info-pannl",
          "fields": {
            "accountId": {
              "candidates": [
                {
                  "id": "named-profile",
                  "read": {
                    "css": "a[href*=\"userdetails.php\"][class*=\"_Name\"]",
                    "mode": "attribute",
                    "attribute": "href"
                  },
                  "then": [
                    {
                      "queryParam": "id"
                    },
                    "identifier"
                  ]
                },
                {
                  "id": "site",
                  "read": {
                    "css": ".user-id a",
                    "mode": "attribute",
                    "attribute": "href"
                  },
                  "then": [
                    {
                      "queryParam": "id"
                    },
                    "identifier"
                  ]
                }
              ]
            },
            "accountUrl": {
              "candidates": [
                {
                  "id": "named-profile",
                  "read": {
                    "css": "a[href*=\"userdetails.php\"][class*=\"_Name\"]",
                    "mode": "attribute",
                    "attribute": "href"
                  },
                  "then": [
                    "url"
                  ]
                },
                {
                  "id": "site",
                  "read": {
                    "css": ".user-id a",
                    "mode": "attribute",
                    "attribute": "href"
                  },
                  "then": [
                    "url"
                  ]
                }
              ]
            },
            "username": {
              "candidates": [
                {
                  "id": "site",
                  "read": {
                    "css": ".user-id a",
                    "mode": "text"
                  },
                  "then": [
                    "trim"
                  ]
                }
              ]
            },
            "uploadedBytes": {
              "candidates": [
                {
                  "id": "adjacent",
                  "read": {
                    "css": ".color_uploaded",
                    "mode": "followingText"
                  },
                  "then": [
                    "bytes"
                  ]
                },
                {
                  "id": "label",
                  "read": {
                    "label": [
                      "Uploaded",
                      "上传量",
                      "上傳量"
                    ],
                    "within": ":scope"
                  },
                  "then": [
                    "bytes"
                  ]
                }
              ]
            },
            "downloadedBytes": {
              "candidates": [
                {
                  "id": "adjacent",
                  "read": {
                    "css": ".color_downloaded",
                    "mode": "followingText"
                  },
                  "then": [
                    "bytes"
                  ]
                },
                {
                  "id": "label",
                  "read": {
                    "label": [
                      "Downloaded",
                      "下载量",
                      "下載量"
                    ],
                    "within": ":scope"
                  },
                  "then": [
                    "bytes"
                  ]
                }
              ]
            },
            "ratio": {
              "candidates": [
                {
                  "id": "wrapped",
                  "read": {
                    "css": ".color_ratio + font, .color_ratio + span",
                    "mode": "text"
                  },
                  "then": [
                    "ratio"
                  ]
                },
                {
                  "id": "adjacent",
                  "read": {
                    "css": ".color_ratio",
                    "mode": "followingText"
                  },
                  "then": [
                    "ratio"
                  ]
                },
                {
                  "id": "label",
                  "read": {
                    "label": [
                      "Ratio",
                      "分享率"
                    ],
                    "within": ":scope"
                  },
                  "then": [
                    "ratio"
                  ]
                }
              ]
            },
            "seeding": {
              "candidates": [
                {
                  "id": "site",
                  "read": {
                    "css": ":scope",
                    "mode": "text"
                  },
                  "then": [
                    {
                      "regex": "当前做种\\s*([0-9,]+)",
                      "group": 1
                    },
                    "integer"
                  ]
                }
              ]
            },
            "bonus": {
              "candidates": [
                {
                  "id": "bonus-link-text",
                  "read": {
                    "css": "a[href*=\"mybonus.php\"]",
                    "mode": "text"
                  },
                  "then": [
                    "trim",
                    {
                      "regex": "^[^0-9]*([0-9][0-9,]*(?:\\.[0-9]+)?)\\s*$",
                      "group": 1
                    },
                    "decimal"
                  ]
                },
                {
                  "id": "bonus-link",
                  "read": {
                    "css": "a[href*=\"mybonus.php\"]",
                    "mode": "followingText"
                  },
                  "then": [
                    {
                      "regex": "([0-9][0-9,.]*)",
                      "group": 1
                    },
                    "decimal"
                  ]
                },
                {
                  "id": "primary",
                  "read": {
                    "label": [
                      "Bonus",
                      "魔力值",
                      "积分"
                    ],
                    "within": ":scope"
                  },
                  "then": [
                    "decimal"
                  ]
                }
              ]
            },
            "level": {
              "candidates": [
                {
                  "id": "site",
                  "read": {
                    "css": ".user-id a",
                    "mode": "attribute",
                    "attribute": "class"
                  },
                  "then": [
                    {
                      "regex": "([A-Za-z_]+)_Name",
                      "group": 1
                    }
                  ]
                }
              ]
            },
            "leeching": {
              "candidates": [
                {
                  "id": "site",
                  "read": {
                    "css": ":scope",
                    "mode": "text"
                  },
                  "then": [
                    {
                      "regex": "正在下载\\s*([0-9,]+)",
                      "group": 1
                    },
                    "integer"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
