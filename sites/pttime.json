{
  "schemaVersion": 1,
  "type": "site",
  "id": "pttime",
  "code": 6,
  "publishedAt": 1792028576,
  "architecture": "nexusphp",
  "domains": [
    "www.pttime.org"
  ],
  "compatibility": {
    "engine": 1,
    "features": [
      "tag-filter.v1"
    ]
  },
  "base": {
    "minCode": 9,
    "maxCode": 17
  },
  "patches": [
    {
      "op": "replace",
      "path": "/pages/list/request/query/resource-tag",
      "value": {
        "id": "resource-tag",
        "input": "tag",
        "param": "tags",
        "map": {
          "no-repost": "jz",
          "mandarin": "gy",
          "chinese-subtitles": "zz",
          "bilingual-subtitles": "zy",
          "cantonese": "yue",
          "diy": "diy",
          "dolby": "dbsj",
          "hdr": "hdr",
          "ongoing": "lz",
          "disc": "dwj",
          "premiere": "zg"
        }
      }
    },
    {
      "op": "prepend",
      "path": "/pages/account/parsers",
      "value": [
        {
          "id": "pttime-panel",
          "scope": "#info_block",
          "fields": {
            "uploadedBytes": {
              "candidates": [
                {
                  "id": "label",
                  "read": {
                    "label": [
                      "上传",
                      "上傳"
                    ],
                    "within": ":scope"
                  },
                  "then": [
                    "bytes"
                  ]
                }
              ]
            },
            "downloadedBytes": {
              "candidates": [
                {
                  "id": "label",
                  "read": {
                    "label": [
                      "下载",
                      "下載"
                    ],
                    "within": ":scope"
                  },
                  "then": [
                    "bytes"
                  ]
                }
              ]
            },
            "ratio": {
              "candidates": [
                {
                  "id": "label",
                  "read": {
                    "label": [
                      "分享率"
                    ],
                    "within": ":scope"
                  },
                  "then": [
                    {
                      "regex": "(\\d[\\d,.]*)",
                      "group": 1
                    },
                    "ratio"
                  ]
                }
              ]
            },
            "seeding": {
              "candidates": [
                {
                  "id": "activity",
                  "read": {
                    "css": "font[title=\"当前做种\"]",
                    "mode": "followingText"
                  },
                  "then": [
                    "integer"
                  ]
                }
              ]
            },
            "leeching": {
              "candidates": [
                {
                  "id": "activity",
                  "read": {
                    "css": "font[title=\"当前下载\"]",
                    "mode": "followingText"
                  },
                  "then": [
                    "integer"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "op": "prepend",
      "path": "/pages/list/states/empty",
      "value": [
        {
          "css": "table.main td.text",
          "text": "^\\s*结果为0，请更换关键词或更换分类。\\s*$"
        }
      ]
    }
  ]
}
