{
  "schemaVersion": 1,
  "type": "site",
  "id": "hhanclub",
  "code": 4,
  "publishedAt": 1792028576,
  "architecture": "nexusphp",
  "domains": [
    "hhanclub.net"
  ],
  "compatibility": {
    "engine": 1,
    "features": [
      "tag-filter.v1",
      "tag-key-suffix.v1"
    ]
  },
  "base": {
    "minCode": 11,
    "maxCode": 17
  },
  "patches": [
    {
      "op": "replace",
      "path": "/pages/list/request/query/resource-tag",
      "value": {
        "id": "resource-tag",
        "param": "tag_id",
        "input": "tag",
        "encoding": "keySuffix",
        "map": {
          "official-release": 3,
          "completed": 17,
          "original": 8,
          "no-repost": 1,
          "premiere": 2,
          "mandarin": 5,
          "cantonese": 10,
          "chinese-subtitles": 6,
          "diy": 11,
          "dolby": 12,
          "hdr": 7
        }
      }
    },
    {
      "op": "prepend",
      "path": "/pages/account/parsers",
      "value": [
        {
          "id": "hhanclub-panel",
          "scope": "#user-info-panel",
          "fields": {
            "accountId": {
              "candidates": [
                {
                  "id": "named-profile",
                  "read": {
                    "css": "a[href*=\"userdetails.php\"][class*=\"_Name\"]",
                    "mode": "attribute",
                    "attribute": "href"
                  },
                  "then": [
                    {
                      "queryParam": "id"
                    },
                    "identifier"
                  ]
                },
                {
                  "id": "primary",
                  "read": {
                    "css": "a[href*=\"userdetails.php?id=\"]",
                    "mode": "attribute",
                    "attribute": "href"
                  },
                  "then": [
                    {
                      "queryParam": "id"
                    },
                    "identifier"
                  ]
                }
              ]
            },
            "accountUrl": {
              "candidates": [
                {
                  "id": "named-profile",
                  "read": {
                    "css": "a[href*=\"userdetails.php\"][class*=\"_Name\"]",
                    "mode": "attribute",
                    "attribute": "href"
                  },
                  "then": [
                    "url"
                  ]
                },
                {
                  "id": "primary",
                  "read": {
                    "css": "a[href*=\"userdetails.php?id=\"]",
                    "mode": "attribute",
                    "attribute": "href"
                  },
                  "then": [
                    "url"
                  ]
                }
              ]
            },
            "username": {
              "candidates": [
                {
                  "id": "named-profile",
                  "read": {
                    "css": "a[href*=\"userdetails.php\"][class*=\"_Name\"]",
                    "mode": "text"
                  },
                  "then": [
                    "trim"
                  ]
                },
                {
                  "id": "primary",
                  "read": {
                    "css": "a[href*=\"userdetails.php?id=\"]",
                    "mode": "text"
                  },
                  "then": [
                    "trim"
                  ]
                }
              ]
            },
            "uploadedBytes": {
              "candidates": [
                {
                  "id": "site",
                  "read": {
                    "css": "img[alt=\"上传\"]",
                    "mode": "followingText"
                  },
                  "then": [
                    "bytes"
                  ]
                }
              ]
            },
            "downloadedBytes": {
              "candidates": [
                {
                  "id": "site",
                  "read": {
                    "css": "img[alt=\"下载\"]",
                    "mode": "followingText"
                  },
                  "then": [
                    "bytes"
                  ]
                }
              ]
            },
            "ratio": {
              "candidates": [
                {
                  "id": "site",
                  "read": {
                    "css": "img[alt=\"分享率\"] + div",
                    "mode": "text"
                  },
                  "then": [
                    {
                      "regex": "([0-9]+(?:\\.[0-9]+)?)",
                      "group": 1
                    },
                    "ratio"
                  ]
                }
              ]
            },
            "seeding": {
              "candidates": [
                {
                  "id": "site",
                  "read": {
                    "css": "img[alt=\"做种数\"]",
                    "mode": "followingText"
                  },
                  "then": [
                    "integer"
                  ]
                }
              ]
            },
            "bonus": {
              "candidates": [
                {
                  "id": "site",
                  "read": {
                    "css": "img[alt=\"憨豆\"] + a",
                    "mode": "text"
                  },
                  "then": [
                    "decimal"
                  ]
                }
              ]
            },
            "level": {
              "candidates": [
                {
                  "id": "class",
                  "read": {
                    "css": "a[href*=\"userdetails.php\"][class*=\"_Name\"]",
                    "mode": "attribute",
                    "attribute": "class"
                  },
                  "then": [
                    {
                      "regex": "([A-Za-z_]+)_Name",
                      "group": 1
                    }
                  ]
                },
                {
                  "id": "label",
                  "read": {
                    "label": [
                      "Class",
                      "等级",
                      "等級"
                    ],
                    "within": ":scope"
                  },
                  "then": [
                    "trim"
                  ]
                }
              ]
            },
            "leeching": {
              "candidates": [
                {
                  "id": "site",
                  "read": {
                    "css": "img[alt=\"下载数\"]",
                    "mode": "followingText"
                  },
                  "then": [
                    "integer"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    {
      "op": "prepend",
      "path": "/pages/list/states/empty",
      "value": [
        {
          "css": ".tips",
          "text": "^\\s*没有种子。请用准确的关键字重试。\\s*$"
        }
      ]
    }
  ]
}
