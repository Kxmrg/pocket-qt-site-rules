{
  "schemaVersion": 1,
  "type": "site",
  "id": "novahd",
  "code": 2,
  "publishedAt": 1792028576,
  "architecture": "nexusphp",
  "domains": [
    "pt.novahd.top"
  ],
  "compatibility": {
    "engine": 1,
    "features": [
      "tag-filter.v1"
    ]
  },
  "base": {
    "minCode": 16,
    "maxCode": 17
  },
  "patches": [
    {
      "op": "replace",
      "path": "/pages/list/request/query/resource-tag",
      "value": {
        "id": "resource-tag",
        "input": "tag",
        "param": "tag_id",
        "map": {
          "no-repost": "1",
          "premiere": "2",
          "official-release": "3",
          "diy": "4",
          "mandarin": "5",
          "chinese-subtitles": "6",
          "hdr": "7",
          "resident": "8",
          "episodic": "9",
          "completed": "10",
          "dolby": "14",
          "ongoing": "18"
        }
      }
    },
    {
      "op": "replace",
      "path": "/pages/account/parsers/panel/fields/bonus/candidates",
      "value": [
        {
          "id": "novahd-bonus",
          "read": {
            "css": "[data-nova-header-bonus]",
            "mode": "text"
          },
          "then": [
            "decimal"
          ]
        }
      ]
    },
    {
      "op": "replace",
      "path": "/pages/account/parsers/theme-panel/fields/bonus/candidates",
      "value": [
        {
          "id": "novahd-bonus",
          "read": {
            "css": "[data-nova-header-bonus]",
            "mode": "text"
          },
          "then": [
            "decimal"
          ]
        }
      ]
    }
  ]
}
