{
  "schemaVersion": 1,
  "type": "site",
  "id": "opencd",
  "code": 2,
  "publishedAt": 1792028576,
  "architecture": "nexusphp",
  "domains": [
    "open.cd"
  ],
  "compatibility": {
    "engine": 1,
    "features": [
      "tag-filter.v1"
    ]
  },
  "base": {
    "minCode": 16,
    "maxCode": 17
  },
  "patches": [
    {
      "op": "replace",
      "path": "/pages/list/request/query/resource-tag",
      "value": {
        "id": "resource-tag",
        "input": "tag",
        "param": "tag_id",
        "map": {}
      }
    },
    {
      "op": "prepend",
      "path": "/pages/account/parsers/panel/fields/bonus/candidates",
      "value": [
        {
          "id": "opencd-bonus",
          "read": {
            "css": "font.color_bonus",
            "mode": "followingText"
          },
          "then": [
            {
              "regex": "([0-9][0-9,.]*)",
              "group": 1
            },
            "decimal"
          ]
        }
      ]
    }
  ]
}
