{
  "schemaVersion": 1,
  "type": "site",
  "id": "keepfrds",
  "code": 2,
  "publishedAt": 1792028576,
  "architecture": "nexusphp",
  "domains": [
    "pt.keepfrds.com"
  ],
  "compatibility": {
    "engine": 1,
    "features": [
      "tag-filter.v1"
    ]
  },
  "base": {
    "minCode": 16,
    "maxCode": 17
  },
  "patches": [
    {
      "op": "replace",
      "path": "/pages/list/request/query/resource-tag",
      "value": {
        "id": "resource-tag",
        "input": "tag",
        "param": "tag_id",
        "map": {}
      }
    },
    {
      "op": "prepend",
      "path": "/pages/list/parsers/semantic/fields/tags/candidates",
      "value": [
        {
          "id": "restricted-release",
          "read": {
            "css": "font.recommended",
            "mode": "texts"
          },
          "then": [
            "stringList"
          ]
        }
      ]
    },
    {
      "op": "replace",
      "path": "/pages/list/parsers/semantic/fields/title",
      "value": {
        "candidates": [
          {
            "id": "named",
            "read": {
              "css": ".small_descr, .small-description, .subtitle, .torrent_title_desc, .torrent-small-description, .torrent-smalldescr",
              "mode": "text",
              "exclude": [
                ".tag, .tags, .torrent-tag, .torrent_tag, a[href*=\"tag_id=\"], span[style*=\"background-color\"][style*=\"padding\"], a[href*=\"download.php\"], a[href^=\"javascript:\"], img",
                "span.label.label-primary, span.label.label-warning, span.label.label-info, span.label.label-danger, span.label.label-success, span.label.label-default",
                ".torrent-content-tag, .torrent-sticky-level-tag, .optiontag, .chs_tag, .circle, .torrent-tag",
                "b",
                ".famfamfam-silk"
              ]
            },
            "then": [
              "trim"
            ]
          },
          {
            "id": "named-block",
            "read": {
              "css": "table.torrentname td.embedded > div[title][style*=\"text-overflow\"], .torrent-subtitle[title]",
              "mode": "attribute",
              "attribute": "title"
            },
            "then": [
              "trim"
            ]
          },
          {
            "id": "reviewed-name-line",
            "read": {
              "css": "table.torrentname td.embedded > span[title=\"通过\"] + br, table.torrentname td.embedded > span[title=\"未审\"] + br",
              "mode": "followingContent",
              "exclude": [
                ".tag, .tags, .torrent-tag, .torrent_tag, a[href*=\"tag_id=\"], span[style*=\"background-color\"][style*=\"padding\"], a[href*=\"download.php\"], a[href^=\"javascript:\"], img",
                "span.label.label-primary, span.label.label-warning, span.label.label-info, span.label.label-danger, span.label.label-success, span.label.label-default",
                ".torrent-content-tag, .torrent-sticky-level-tag, .optiontag, .chs_tag, .circle, .torrent-tag",
                "b",
                ".famfamfam-silk"
              ]
            },
            "then": [
              "trim"
            ]
          },
          {
            "id": "name-line",
            "read": {
              "css": "table.torrentname td.embedded > br",
              "mode": "followingContent",
              "exclude": [
                ".tag, .tags, .torrent-tag, .torrent_tag, a[href*=\"tag_id=\"], span[style*=\"background-color\"][style*=\"padding\"], a[href*=\"download.php\"], a[href^=\"javascript:\"], img",
                "span.label.label-primary, span.label.label-warning, span.label.label-info, span.label.label-danger, span.label.label-success, span.label.label-default",
                ".torrent-content-tag, .torrent-sticky-level-tag, .optiontag, .chs_tag, .circle, .torrent-tag",
                "b",
                ".famfamfam-silk"
              ]
            },
            "then": [
              "trim"
            ]
          },
          {
            "id": "line",
            "read": {
              "css": "td > a[href*=\"details.php?id=\"] ~ br",
              "mode": "followingContent",
              "exclude": [
                ".tag, .tags, .torrent-tag, .torrent_tag, a[href*=\"tag_id=\"], span[style*=\"background-color\"][style*=\"padding\"], a[href*=\"download.php\"], a[href^=\"javascript:\"], img",
                "span.label.label-primary, span.label.label-warning, span.label.label-info, span.label.label-danger, span.label.label-success, span.label.label-default",
                ".torrent-content-tag, .torrent-sticky-level-tag, .optiontag, .chs_tag, .circle, .torrent-tag",
                "b",
                ".famfamfam-silk"
              ]
            },
            "then": [
              "trim"
            ]
          }
        ]
      }
    },
    {
      "op": "replace",
      "path": "/pages/list/parsers/semantic/fields/subtitle",
      "value": {
        "candidates": [
          {
            "id": "name-table-attribute",
            "read": {
              "css": "table.torrentname a[href*=\"details.php?\"]:not([href*=\"cmtpage=\"]):not([href*=\"dllist=\"]):not([href*=\"#\"])",
              "mode": "attribute",
              "attribute": "title"
            },
            "then": [
              "trim"
            ]
          },
          {
            "id": "name-table-text",
            "read": {
              "css": "table.torrentname a[href*=\"details.php?\"]:not([href*=\"cmtpage=\"]):not([href*=\"dllist=\"]):not([href*=\"#\"])",
              "mode": "text"
            },
            "then": [
              "trim"
            ]
          },
          {
            "id": "title-link-attribute",
            "read": {
              "css": "a[href*=\"details.php?\"][title]",
              "mode": "attribute",
              "attribute": "title"
            },
            "then": [
              "trim"
            ]
          },
          {
            "id": "title-link-text",
            "read": {
              "css": "a[href*=\"details.php?\"][title]",
              "mode": "text"
            },
            "then": [
              "trim"
            ]
          },
          {
            "id": "attribute",
            "read": {
              "css": "a[href*=\"details.php?\"]:not([href*=\"cmtpage=\"]):not([href*=\"dllist=\"]):not([href*=\"#\"])",
              "mode": "attribute",
              "attribute": "title"
            },
            "then": [
              "trim"
            ]
          },
          {
            "id": "text",
            "read": {
              "css": "a[href*=\"details.php?\"]:not([href*=\"cmtpage=\"]):not([href*=\"dllist=\"]):not([href*=\"#\"])",
              "mode": "text"
            },
            "then": [
              "trim"
            ]
          }
        ]
      }
    }
  ]
}
